# Copie para .env e preencha. O .env nunca é versionado.
# O Makefile carrega este arquivo automaticamente (ver DECISIONS.md).

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Modelo configurável. Sem padrão no código: o padrão do projeto sai da comparação da Fase 5.
# Opções: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
# Na Fase 4 estamos usando claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Profundidade de raciocínio do modelo: low | medium | high. "low" é o padrão (triagem é tarefa
# simples e raciocínio custa tokens); aceito por todos os modelos acima.
ANTHROPIC_EFFORT=low

# --- Embeddings locais (sentence-transformers); o modelo é baixado na primeira execução ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Observabilidade (opcional) ---
# Langfuse só é ativado se as duas chaves abaixo estiverem preenchidas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
