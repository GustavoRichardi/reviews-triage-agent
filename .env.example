# Copie para .env e preencha. O .env nunca é versionado.
# O Makefile carrega este arquivo automaticamente (ver DECISIONS.md).

# --- LLM (Anthropic) --- usado a partir da Fase 4
ANTHROPIC_API_KEY=
# Modelo configurável; o padrão será definido na Fase 4 (decisão de custo).
ANTHROPIC_MODEL=

# --- Embeddings locais (sentence-transformers) --- usado a partir da Fase 4
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Observabilidade (opcional) ---
# Langfuse só é ativado se as duas chaves abaixo estiverem preenchidas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
